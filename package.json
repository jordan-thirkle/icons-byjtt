{
  "name": "@byjtt/icons",
  "version": "0.1.0",
  "private": true,
  "description": "Open-source, AI-friendly SVG icon system by BY JTT.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "python3 -m http.server 4173",
    "check": "node scripts/validate.mjs",
    "test": "node --test scripts/tests/*.test.mjs",
    "generate": "node scripts/generate.mjs",
    "pack:core": "npm pack ./packages/core --pack-destination ./dist",
    "publish:core": "npm publish ./packages/core --access public",
    "test:mcp": "node --test scripts/tests/mcp.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.1.0",
    "zod": "^4.0.0"
  }
}
